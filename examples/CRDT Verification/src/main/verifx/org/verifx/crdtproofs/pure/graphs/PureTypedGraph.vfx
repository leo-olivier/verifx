import org.verifx.crdtproofs.VersionVector
import org.verifx.crdtproofs.lemmas.PureCRDTProof4
import org.verifx.crdtproofs.pure.PureOpBasedCRDT

/*
 * Pure op-based typed graph. 
 *
 * A type graph specifies a set of vertex and edge types and the allowed typed arcs between source and target types.
 * In addition, it can specifcy a set of constraints, such as multiplicity
 * (i.e., how many instances of an incident edge type are allowed per instance of a vertex type).
 * A typed graph is a directed multigraph where edges and vertices are labelled by their types and the typed arcs
 * conform to the schema expressed by the type graph. They are notably used in Model-Driven Engineering (MDE)
 * to represent UML class and object diagrams.
 *
 * For more details, see:
 *       "A graph-based semantics for UML class and object diagrams" (2008), by Kleppe, AG and Rensink, Arend
 *
 * In this implementation, the schema is immutable and shared by all replicas. We consider a typed graph enriched 
 * with the multiplicity upper bound. We assume the arcs to be unordered.
 *
 * The Pure Typed Graph extend the conflict-resolution policy of the Pure Multidigraph. Conflicts are resolved as follows:
 * - Add arc/Add arc: if the upper bound is exceeded, the arc with the oldest timestamp (according to the arbitration order) is kept ;
 * - Add arc/remove vertex: if the source or target vertex is removed, the arc is hidden.
 *    If a concurrent add reintroduces the removed vertex, the arc is visible again.
 * - Add vertex/remove vertex: the vertex is kept.
 * - Add arc/remove arc: the arc is kept.
 */

/*
 * TYPE GRAPH
*/

// Multiplicity
object ArcBounds {
    enum ArcBound {
        Bounded(max: Int) |
        Unbounded()
    }
}

// The type graph schema
class TypeGraph[VertexType, EdgeType](
    // Allowed arcs
    allowedFn: (VertexType, EdgeType, VertexType) => Boolean,
    // Multiplicity of arcs leaving a source vertex of a given type
    upperBoundFn: (EdgeType, VertexType) => ArcBound
) {
    def allows(
        sourceType: VertexType,
        edgeType: EdgeType,
        targetType: VertexType
    ): Boolean =
        this.allowedFn(sourceType, edgeType, targetType)

    def upperBound(
        edgeType: EdgeType,
        sourceType: VertexType
    ): ArcBound =
        this.upperBoundFn(edgeType, sourceType)

    // The type graph is correct if all multiplicity upper bounds are non-negative integers or unbounded.
    def isCorrect(): Boolean =
        forall(edgeType: EdgeType, sourceType: VertexType) {
            this.upperBound(edgeType, sourceType) match {
                case Bounded(max) => max >= 0
                case Unbounded() => true
            }
        }
}

// A typed vertex has an id and is labelled by its type
class TypedVertex[V, VertexType](id: V, vertexType: VertexType)

// Used to classify arcs by source vertex and edge type.
class TypedIncidence[V, VertexType, EdgeType](
    vertex: TypedVertex[V, VertexType],
    edgeType: EdgeType
)

// A typed arc has an id, a source vertex, a target vertex,
// and is labelled by its edge type.
class TypedArc[V, VertexType, E, EdgeType](
    source: TypedVertex[V, VertexType],
    id: E,
    edgeType: EdgeType,
    target: TypedVertex[V, VertexType]
) {
    def equals(that: TypedArc[V, VertexType, E, EdgeType]): Boolean =
        this.source == that.source &&
        this.id == that.id &&
        this.edgeType == that.edgeType &&
        this.target == that.target

    def incidence(): TypedIncidence[V, VertexType, EdgeType] =
        new TypedIncidence[V, VertexType, EdgeType](
            this.source,
            this.edgeType
        )
}

/*
 * ARC SORTING & CONFICT RESOLUTION
*/

// Abstract deterministic arbitration order shared by all replica.
// The typed graph is correct for any implementation of lessFn that is a
// strict total order and extends the causal order on version vectors.
class VersionVectorOrder(
    lessFn: (VersionVector, VersionVector) => Boolean
) {
    def less(x: VersionVector, y: VersionVector): Boolean =
        this.lessFn(x, y)

    def isCorrect(): Boolean =
      // Irreflexive
      forall(x: VersionVector) {
        !this.less(x, x)
      } &&
      // Asymmetric
      forall(x: VersionVector, y: VersionVector) {
        this.less(x, y) =>: !this.less(y, x)
      } &&
      // Transitive
      forall(
        x: VersionVector,
        y: VersionVector,
        z: VersionVector
      ) {
        (
          this.less(x, y) &&
          this.less(y, z)
        ) =>: this.less(x, z)
      } &&
      // Total
      forall(x: VersionVector, y: VersionVector) {
        x == y || this.less(x, y) || this.less(y, x)
      } &&
      // Linear extension of causality
      forall(x: VersionVector, y: VersionVector) {
        x.before(y) =>: this.less(x, y)
      }
}

// Timestamped value used by the grouping boundary.
class ArcCandidate[V, VertexType, E, EdgeType](
    arc: TypedArc[V, VertexType, E, EdgeType],
    time: VersionVector
) {
    def incidence(): TypedIncidence[V, VertexType, EdgeType] =
        this.arc.incidence()
}

// The group function enumerates and groups candidates.
// It transform a set of candidates into a map from typed incidences to ordered lists of candidates.
// We use this abstraction to bypass CAL theory limitations.
// Note: it does not select multiplicity winners.
class ArcGrouping[V, VertexType, E, EdgeType](
    groupFn: Set[ArcCandidate[V, VertexType, E, EdgeType]] =>
        Map[
            TypedIncidence[V, VertexType, EdgeType],
            LList[ArcCandidate[V, VertexType, E, EdgeType]]
        ]
) {
    def group(
        candidates: Set[ArcCandidate[V, VertexType, E, EdgeType]]
    ): Map[
        TypedIncidence[V, VertexType, EdgeType],
        LList[ArcCandidate[V, VertexType, E, EdgeType]]
    ] =
        this.groupFn(candidates)

    // Contract for the abstract finite enumeration performed by groupFn.
    // Every candidate occurs exactly once in its incidence bucket, buckets do
    // not invent candidates, and each bucket is ordered from oldest to newest.
    def isCorrectFor(
        candidates: Set[ArcCandidate[V, VertexType, E, EdgeType]],
        clockOrder: VersionVectorOrder
    ): Boolean = {
        val groups = this.group(candidates)

        // Every candidate is represented in its incidence bucket. In
        // particular, a non-empty candidate set cannot map to no buckets.
        candidates.forall(
            (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
                groups.contains(candidate.incidence()) &&
                groups.get(candidate.incidence()).exists(
                    (entry: ArcCandidate[V, VertexType, E, EdgeType]) =>
                        entry == candidate
                )
        ) &&
        groups.forall(
            (
                incidence: TypedIncidence[V, VertexType, EdgeType],
                entries: LList[ArcCandidate[V, VertexType, E, EdgeType]]
            ) =>
                entries.wellFormed() &&
                // Buckets contain only candidates of their own incidence.
                entries.forall(
                    (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
                        candidates.contains(candidate) &&
                        candidate.incidence() == incidence
                ) &&
                // A candidate cannot occur at two positions.
                forall(first: Int, second: Int) {
                    ((
                        first >= 0 &&
                        first < entries.size &&
                        second >= 0 &&
                        second < entries.size &&
                        entries.get(first) == entries.get(second)
                    ) =>: (first == second))
                } &&
                // Candidates are enumerated oldest first.
                forall(first: Int, second: Int) {
                    ((
                        first >= 0 &&
                        first < second &&
                        second < entries.size
                    ) =>: !clockOrder.less(
                        entries.get(second).time,
                        entries.get(first).time
                    ))
                }
        )
    }

    // Special helper for proofs used when one bucket contains exactly
    // two known candidates. Both permutations are accepted before the clock
    // order determines which candidate must occur first.
    def isCorrectPairForBucket(
        candidates: Set[ArcCandidate[V, VertexType, E, EdgeType]],
        incidence: TypedIncidence[V, VertexType, EdgeType],
        candidate1: ArcCandidate[V, VertexType, E, EdgeType],
        candidate2: ArcCandidate[V, VertexType, E, EdgeType],
        clockOrder: VersionVectorOrder
    ): Boolean = {
        val groups = this.group(candidates)
        val entries = groups.getOrElse(
            incidence,
            new LList[ArcCandidate[V, VertexType, E, EdgeType]]()
        )

        groups.contains(incidence) &&
        entries.size == 2 &&
        entries.elements.contains(0) &&
        entries.elements.contains(1) &&
        candidate1 != candidate2 &&
        candidate1.incidence() == incidence &&
        candidate2.incidence() == incidence &&
        candidates.contains(candidate1) &&
        candidates.contains(candidate2) &&
        candidates.forall(
            (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
                candidate.incidence() != incidence ||
                candidate == candidate1 ||
                candidate == candidate2
        ) &&
        (
            (
                entries.get(0) == candidate1 &&
                entries.get(1) == candidate2
            ) ||
            (
                entries.get(0) == candidate2 &&
                entries.get(1) == candidate1
            )
        ) &&
        !clockOrder.less(
            entries.get(1).time,
            entries.get(0).time
        )
    }
}

/*
 * RETURNED EVALUATED GRAPH
*/

// Labelled typed graph value returned by a read query over the PO-Log.
class TypedGraph[V, VertexType, E, EdgeType](
    vertices: Set[TypedVertex[V, VertexType]],
    arcs: Map[
        TypedIncidence[V, VertexType, EdgeType],
        LList[TypedArc[V, VertexType, E, EdgeType]]
    ]
) {
    def containsVertex(vertex: TypedVertex[V, VertexType]): Boolean =
        this.vertices.contains(vertex)

    def containsArc(arc: TypedArc[V, VertexType, E, EdgeType]): Boolean = {
        val incidence = arc.incidence()
        this.arcs.contains(incidence) &&
        this.arcs.get(incidence).exists(
            (entry: TypedArc[V, VertexType, E, EdgeType]) =>
                entry.equals(arc)
        )
    }

    def isValid(
        schema: TypeGraph[VertexType, EdgeType]
    ): Boolean =
        schema.isCorrect() &&
        this.arcs.forall(
            (
                incidence: TypedIncidence[V, VertexType, EdgeType],
                entries: LList[TypedArc[V, VertexType, E, EdgeType]]
            ) =>
                // The arcs respect the multiplicity upper bound
                (schema.upperBound(
                    incidence.edgeType,
                    incidence.vertex.vertexType
                ) match {
                    case Bounded(max) => entries.size <= max
                    case Unbounded() => true
                }) &&
                entries.wellFormed() &&
                // Every visible arc has visible endpoints...
                entries.forall(
                    (arc: TypedArc[V, VertexType, E, EdgeType]) =>
                        arc.incidence() == incidence &&
                        this.vertices.contains(arc.source) &&
                        this.vertices.contains(arc.target) &&
                        // ...and the arc is allowed by the schema.
                        schema.allows(
                            arc.source.vertexType,
                            arc.edgeType,
                            arc.target.vertexType
                        )
                )
        )
}

/*
 * PURE TYPED GRAPH CRDT
*/

// Operations of the Pure Typed Graph CRDT.
object TypedGraphOps {
    enum TypedGraphOp[V, VertexType, E, EdgeType] {
        AddVertex(vertex: TypedVertex[V, VertexType]) |
        RemoveVertex(id: V) |
        AddArc(arc: TypedArc[V, VertexType, E, EdgeType]) |
        RemoveArc(source: V, edge: E, target: V)
    }
}

// Pure op-based typed graph CRDT.
class PureTypedGraph[V, VertexType, E, EdgeType](
  schema: TypeGraph[VertexType, EdgeType],
  clockOrder: VersionVectorOrder,
  arcGrouping: ArcGrouping[V, VertexType, E, EdgeType],
  polog: Set[TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]]
) extends PureOpBasedCRDT[
  TypedGraphOp[V, VertexType, E, EdgeType],
  PureTypedGraph[V, VertexType, E, EdgeType]
] {
  def copy(
    newPolog: Set[TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]]
  ): PureTypedGraph[V, VertexType, E, EdgeType] =
    new PureTypedGraph[V, VertexType, E, EdgeType](
      this.schema,
      this.clockOrder,
      this.arcGrouping,
      newPolog
    )

  // Remove operations make their effect and then are redundant
  def selfRedundant(
    op: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]
  ): Boolean = op.o match {
    case _: RemoveVertex[V, VertexType, E, EdgeType] => true
    case _: RemoveArc[V, VertexType, E, EdgeType] => true
    case _ => false
  }

  def redundantBy(
    x: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]],
    y: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]
  ): Boolean = {
    x.t.before(y.t) && {
      x.o match {
        // A previous addition of a vertex is made redundant
        // by a later add of the same vertex or a remove of that vertex.
        case oldAdd: AddVertex =>
          y.o match {
            case laterAdd: AddVertex =>
              oldAdd.vertex.id == laterAdd.vertex.id
            case laterRemove: RemoveVertex =>
              oldAdd.vertex.id == laterRemove.id
            case _ =>
              false
          }

        // A previous addition of an arc is made redundant
        // by a later addition of the same arc, the removal of that arc
        // or the removal of one of its source/target vertex
        case oldAdd: AddArc =>
          y.o match {
            case laterAdd: AddArc =>
              oldAdd.arc.equals(laterAdd.arc)
            case laterRemove: RemoveArc =>
              oldAdd.arc.source.id == laterRemove.source &&
              oldAdd.arc.id == laterRemove.edge &&
              oldAdd.arc.target.id == laterRemove.target
            case laterRemoveVertex: RemoveVertex =>
              oldAdd.arc.source.id == laterRemoveVertex.id ||
              oldAdd.arc.target.id == laterRemoveVertex.id
            case _ =>
              false
          }

        case _ =>
          false
      }
    }
  }

  def visibleVertices(): Set[TypedVertex[V, VertexType]] =
    this.polog
      .filter((op: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]) =>
        op.o match {
          case _: AddVertex => true
          case _ => false
        }
      )
      .map((op: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]) =>
        op.o
          .asInstanceOf[AddVertex[V, VertexType, E, EdgeType]]
          .vertex
      )

  // The candidates are the visible arcs whose endpoints are visible vertices and whose types are allowed by the schema.
  def candidates(vertices: Set[TypedVertex[V, VertexType]]): Set[ArcCandidate[V, VertexType, E, EdgeType]] = {
    val arcCandidates = this.polog
      .filter((op: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]) =>
        op.o match {
          case add: AddArc =>
            // Only consider arcs whose endpoints are visible...
            vertices.contains(add.arc.source) &&
            vertices.contains(add.arc.target) &&
            // ...and allowed by the schema
            this.schema.allows(
              add.arc.source.vertexType,
              add.arc.edgeType,
              add.arc.target.vertexType
            )
          case _ => false
        }
      )
      .map((op: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]) =>
        new ArcCandidate[V, VertexType, E, EdgeType](
          op.o
            .asInstanceOf[AddArc[V, VertexType, E, EdgeType]]
            .arc,
          op.t
        )
      )

    // Keep the oldest representative of concurrent additions of one logical arc.
    arcCandidates.filter(
      (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
        !arcCandidates.exists(
          (other: ArcCandidate[V, VertexType, E, EdgeType]) =>
            other != candidate &&
            candidate.arc.equals(other.arc) &&
            this.clockOrder.less(other.time, candidate.time)
        )
    )
  }

  // The immutable services used by eval satisfy their semantic contracts for
  // this state's actual candidate set.
  def isWellFormed(): Boolean = {
    val candidates = this.candidates(this.visibleVertices())

    this.schema.isCorrect() &&
    this.clockOrder.isCorrect() &&
    this.arcGrouping.isCorrectFor(candidates, this.clockOrder)
  }

  // Resolve one finite incidence bucket
  def resolveBucket(
    incidence: TypedIncidence[V, VertexType, EdgeType],
    entries: LList[ArcCandidate[V, VertexType, E, EdgeType]],
    candidates: Set[ArcCandidate[V, VertexType, E, EdgeType]]
  ): LList[TypedArc[V, VertexType, E, EdgeType]] = {
    val count = this.schema.upperBound(
      incidence.edgeType,
      incidence.vertex.vertexType
    ) match {
      case Bounded(max) => max
      case Unbounded() => entries.size
    }
    val resultSize =
      if (entries.size < count)
        entries.size
      else
        count

    val resultElements = entries.elements.filter(
      (
        index: Int,
        candidate: ArcCandidate[V, VertexType, E, EdgeType]
      ) =>
        index >= 0 &&
        index < resultSize &&
        candidates.contains(candidate) &&
        candidate.incidence() == incidence
    )
    new LList[ArcCandidate[V, VertexType, E, EdgeType]](
      resultSize,
      resultElements
    ).map(
      (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
        candidate.arc
    )
  }

  // The evaluated graph consists of all visible vertices and arcs
  def eval(): TypedGraph[V, VertexType, E, EdgeType] = {
    val vertices = this.visibleVertices()
    val candidates = this.candidates(vertices)

    // Group candidates by source vertex and edge type,
    // then apply the multiplicity upper bound to each group.
    val arcs = this.arcGrouping.group(candidates).map(
      (
        incidence: TypedIncidence[V, VertexType, EdgeType],
        entries: LList[ArcCandidate[V, VertexType, E, EdgeType]]
      ) => this.resolveBucket(incidence, entries, candidates)
    )

    new TypedGraph[V, VertexType, E, EdgeType](
      vertices,
      arcs
    )
  }

  /* Helper methods for proofs */

  def addArc(
    arc: TypedArc[V, VertexType, E, EdgeType],
    time: VersionVector
  ): PureTypedGraph[V, VertexType, E, EdgeType] =
    this.effect(new AddArc(arc), time)
}

object PureTypedGraph extends PureCRDTProof4[TypedGraphOp, PureTypedGraph] {
  /* Dangling arcs:
   * An arc can only be visible in the evaluated graph when both of its endpoints are visible as vertices.
   * I.e., dangling arcs are hidden, and the invariant A ⊆ V × V × E holds in the evaluated graph.
   */
  proof PureTypedGraph_eval_arc_implies_visible_endpoints[V, VertexType, E, EdgeType] {
    forall(
      g: PureTypedGraph[V, VertexType, E, EdgeType],
      arc: TypedArc[V, VertexType, E, EdgeType]
    ) {
      g.eval().containsArc(arc) =>: (
        g.eval().containsVertex(arc.source) &&
        g.eval().containsVertex(arc.target)
      )
    }
  }

  /* Schema conformance:
   * Every visible arc in the evaluated graph is allowed by the schema.
   */
  proof PureTypedGraph_eval_arc_respects_schema[V, VertexType, E, EdgeType] {
    forall(
      g: PureTypedGraph[V, VertexType, E, EdgeType],
    ) {
      g.eval().arcs.forall(
        (
          incidence: TypedIncidence[V, VertexType, EdgeType],
          entries: LList[TypedArc[V, VertexType, E, EdgeType]]
        ) => entries.forall(
          (arc: TypedArc[V, VertexType, E, EdgeType]) =>
            g.schema.allows(
              arc.source.vertexType,
              arc.edgeType,
              arc.target.vertexType
            )
        )
      )
    }
  }

  /* Multiplicity:
   * The number of visible arcs of a given edge type leaving a source vertex of a given type
    * does not exceed the multiplicity upper bound specified by the schema.
   */
  proof PureTypedGraph_eval_respects_upper_bounds[V, VertexType, E, EdgeType] {
    forall(g: PureTypedGraph[V, VertexType, E, EdgeType]) {
      g.isWellFormed() =>: g.eval().arcs.forall(
        (
          incidence: TypedIncidence[V, VertexType, EdgeType],
          entries: LList[TypedArc[V, VertexType, E, EdgeType]]
        ) =>
          entries.wellFormed() &&
          (g.schema.upperBound(
            incidence.edgeType,
            incidence.vertex.vertexType
          ) match {
            case Bounded(max) => entries.size <= max
            case Unbounded() => true
          })
      )
    }
  }

  /* Complete read validity:
   * For a well-formed CRDT configuration, eval returns a well-formed typed
   * graph whose arcs have visible endpoints, satisfy the schema, are grouped
   * by the right incidence, and respect multiplicity upper bounds.
   */
  proof PureTypedGraph_eval_is_valid[V, VertexType, E, EdgeType] {
    forall(g: PureTypedGraph[V, VertexType, E, EdgeType]) {
      g.isWellFormed() =>: g.eval().isValid(g.schema)
    }
  }

  /* Unbounded-bucket liveness:
   * Correct grouping cannot silently discard an eligible candidate. When its
   * incidence is unbounded, eval returns the candidate's arc.
   */
  proof PureTypedGraph_unbounded_candidate_is_visible[
    V, VertexType, E, EdgeType
  ] {
    forall(
      g: PureTypedGraph[V, VertexType, E, EdgeType],
      candidate: ArcCandidate[V, VertexType, E, EdgeType]
    ) {
      val candidates = g.candidates(g.visibleVertices())
      val incidence = candidate.incidence()

      (
        g.isWellFormed() &&
        candidates.contains(candidate) &&
        (g.schema.upperBound(
          incidence.edgeType,
          incidence.vertex.vertexType
        ) match {
          case Unbounded() => true
          case Bounded(_) => false
        })
      ) =>: g.eval().containsArc(candidate.arc)
    }
  }

  /* Upper bound overflow:
   * The following two lemmas prove a special case of conflict resolution where the concurrent
   * addition of two arcs is incompatible with the multiplicity specified in the schema.
   * Due to Z3 limitations, we prove the correctness of this conflict resolution for the case where
   * the upper multiplicity bound is 1.
   *
   * - The first lemma proves that two concurrent arc additions produce exactly
   *   the expected candidates for their incidence.
   * - The second uses the explicit grouping contract to prove that a bound-one
   *   read keeps the oldest candidate.
   */

  /* Candidate extraction:
   * Adding two valid arcs to an empty incidence 
   * produces exactly the two corresponding candidates in that
   * incidence. This isolates the effect phase from multiplicity resolution.
   */
  proof PureTypedGraph_two_fresh_arcs_form_candidate_set[
    V, VertexType, E, EdgeType
  ] {
    forall(
      g: PureTypedGraph[V, VertexType, E, EdgeType],
      arc1: TypedArc[V, VertexType, E, EdgeType],
      t1: VersionVector,
      arc2: TypedArc[V, VertexType, E, EdgeType],
      t2: VersionVector
    ) {
      val incidence = arc1.incidence()
      val candidate1 =
        new ArcCandidate[V, VertexType, E, EdgeType](arc1, t1)
      val candidate2 =
        new ArcCandidate[V, VertexType, E, EdgeType](arc2, t2)
      val updated = g.addArc(arc1, t1).addArc(arc2, t2)
      val candidates = updated.candidates(g.visibleVertices())

      (
        // Concurrent effects cannot make either new addition redundant.
        t1.concurrent(t2) &&
        t1.isValid() &&
        t2.isValid() &&
        t1.vector.size == t2.vector.size &&
        // The additions are distinct members of the same incidence bucket.
        !arc1.equals(arc2) &&
        incidence == arc2.incidence() &&
        // Both additions are eligible candidates.
        g.visibleVertices().contains(arc1.source) &&
        g.visibleVertices().contains(arc1.target) &&
        g.visibleVertices().contains(arc2.target) &&
        g.schema.allows(
          arc1.source.vertexType,
          arc1.edgeType,
          arc1.target.vertexType
        ) &&
        g.schema.allows(
          arc2.source.vertexType,
          arc2.edgeType,
          arc2.target.vertexType
        ) &&
        // No earlier PO-Log operation can contribute another candidate
        // to this incidence or replace either fresh addition.
        g.polog.forall(
          (op: TaggedOp[TypedGraphOp[V, VertexType, E, EdgeType]]) =>
            op.o match {
              case add: AddArc =>
                add.arc.incidence() != incidence
              case _ => true
            }
        )
      ) =>: (
        candidates.contains(candidate1) &&
        candidates.contains(candidate2) &&
        candidates.forall(
          (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
            candidate.incidence() != incidence ||
            candidate == candidate1 ||
            candidate == candidate2
        )
      )
    }
  }

  /* Bound-one multiplicity resolution:
   * When a correctly grouped incidence contains exactly two candidates and
   * its bound is one, the resolver used by eval retains the first (oldest)
   * candidate and hides the second. Candidate extraction is outside this proof.
   */
  proof PureTypedGraph_bound_one_two_candidate_bucket_keeps_oldest[
    V, VertexType, E, EdgeType
  ] {
    forall(
      g: PureTypedGraph[V, VertexType, E, EdgeType],
      arc1: TypedArc[V, VertexType, E, EdgeType],
      t1: VersionVector,
      arc2: TypedArc[V, VertexType, E, EdgeType],
      t2: VersionVector
    ) {
      val incidence = arc1.incidence()
      val candidate1 =
        new ArcCandidate[V, VertexType, E, EdgeType](arc1, t1)
      val candidate2 =
        new ArcCandidate[V, VertexType, E, EdgeType](arc2, t2)
      val candidates = g.candidates(g.visibleVertices())
      val entries = g.arcGrouping.group(candidates).getOrElse(
        incidence,
        new LList[ArcCandidate[V, VertexType, E, EdgeType]]()
      )
      val resolved = g.resolveBucket(incidence, entries, candidates)

      (
        // Validate the schema, arbitration order, and complete grouping of the
        // candidate set used by this read. This excludes an empty groupFn.
        g.isWellFormed() &&
        // The total timestamp order places candidate1 before candidate2.
        g.clockOrder.less(t1, t2) &&
        !arc1.equals(arc2) &&
        candidate1 != candidate2 &&
        incidence == arc2.incidence() &&
        candidates.contains(candidate1) &&
        candidates.contains(candidate2) &&
        candidates.forall(
          (candidate: ArcCandidate[V, VertexType, E, EdgeType]) =>
            candidate.incidence() != incidence ||
            candidate == candidate1 ||
            candidate == candidate2
        ) &&
        // Exact duplicate-free grouping entails this size. Keeping it explicit
        // avoids an expensive cardinality argument over LList's backing map.
        entries.size == 2 &&
        // This bucket overflows its bound by exactly one candidate.
        (g.schema.upperBound(
          arc1.edgeType,
          arc1.source.vertexType
        ) match {
          case Bounded(max) => max == 1
          case Unbounded() => false
        })
      ) =>: (
        resolved.size == 1 &&
        resolved.get(0).equals(arc1) &&
        !resolved.get(0).equals(arc2)
      )
    }
  }
}
