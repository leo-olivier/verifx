import org.verifx.crdtproofs.VersionVector

/*
 * Implementation of a pure op-based Update-Wins multidigraph nested CRDT,
 * following the specification from:
 *   Olivier, Morcos, Didonet Del Fabro, Gerard.
 *   "A Local-First Collaborative Modeling Approach with Replicated Data Types"
 *   HAL https://cea.hal.science/cea-05322894v1 (2025).
 *
 * Supports nested CRDTs as child elements for vertices and arcs, i.e., each vertex and arc
 * can itself be a CRDT (as long as it is resettable).
 */

// Arc identity
class Arc[V, E](source: V, target: V, id: E)

// CRDT update operations.
object UWGraphOps {
  enum UWGraphOp[V, E, VertexOp, ArcOp] {
    UpdateVertex(id: V, child: VertexOp) |
    RemoveVertex(id: V) |
    UpdateArc(source: V, target: V, id: E, child: ArcOp) |
    RemoveArc(source: V, target: V, id: E)
  }
}

class UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog](
  //! VeriFx cannot use a trait-bounded type parameter here. These function
  //! fields are the explicit interface required from resettable vertex children.
  //! The Boolean argument indicates whether the reset should be conservative (i.e., preserve concurrent child operations) or not.
  vertexEffect: (VertexLog, VertexOp, VersionVector) => VertexLog,
  vertexReset: (VertexLog, VersionVector, Boolean) => VertexLog,
  vertexIsDefault: VertexLog => Boolean,
  emptyVertex: VertexLog,

  //! Same interface for resettable arc children.
  arcEffect: (ArcLog, ArcOp, VersionVector) => ArcLog,
  arcReset: (ArcLog, VersionVector, Boolean) => ArcLog,
  arcIsDefault: ArcLog => Boolean,
  emptyArc: ArcLog,

  // The graph content is stored in two maps: one for vertices and one for arcs.
  arcContent: Map[Arc[V, E], ArcLog] = new Map[Arc[V, E], ArcLog](),
  vertexContent: Map[V, VertexLog] = new Map[V, VertexLog]()
) {
  def copy(
    newArcContent: Map[Arc[V, E], ArcLog],
    newVertexContent: Map[V, VertexLog]
  ) =
    // Preserve the child interface while replacing the graph contents.
    new UWMultidigraphLog(
      this.vertexEffect,
      this.vertexReset,
      this.vertexIsDefault,
      this.emptyVertex,
      this.arcEffect,
      this.arcReset,
      this.arcIsDefault,
      this.emptyArc,
      newArcContent,
      newVertexContent
    )

  // Update-wins creation/update of a vertex: create the child from emptyVertex if
  // absent, then delegate the nested operation to that child.
  def updateVertex(v: V, op: VertexOp, t: VersionVector) = {
    val child = this.vertexContent.getOrElse(v, this.emptyVertex)
    val newChild = this.vertexEffect(child, op, t)
    this.copy(this.arcContent, this.vertexContent.add(v, newChild))
  }

  // Removing a vertex resets its child and every incident arc child. The
  // conservative reset keeps operations concurrent with this remove.
  def removeVertex(v: V, t: VersionVector) = {
    val newVertexContent =
      if (this.vertexContent.contains(v))
        this.vertexContent.add(v, this.vertexReset(this.vertexContent.get(v), t, true))
      else
        this.vertexContent

    val newArcContent =
      this.arcContent.map((arc: Arc[V, E], child: ArcLog) =>
        if (arc.source == v || arc.target == v)
          this.arcReset(child, t, true)
        else
          child
      )

    this.copy(newArcContent, newVertexContent)
  }

  // Update-wins creation/update of an arc child.
  def updateArc(arc: Arc[V, E], op: ArcOp, t: VersionVector) = {
    val child = this.arcContent.getOrElse(arc, this.emptyArc)
    val newChild = this.arcEffect(child, op, t)
    this.copy(this.arcContent.add(arc, newChild), this.vertexContent)
  }

  // Removing an arc does not affect concurrent updates to that arc
  def removeArc(arc: Arc[V, E], t: VersionVector) = {
    val newArcContent =
      if (this.arcContent.contains(arc))
        this.arcContent.add(arc, this.arcReset(this.arcContent.get(arc), t, true))
      else
        this.arcContent

    this.copy(newArcContent, this.vertexContent)
  }

  // Dispatcher matching the operation enum.
  def effect(op: UWGraphOp[V, E, VertexOp, ArcOp], t: VersionVector) = op match {
    case u: UpdateVertex =>
      this.updateVertex(u.id, u.child, t)

    case r: RemoveVertex =>
      this.removeVertex(r.id, t)

    case u: UpdateArc =>
      this.updateArc(new Arc(u.source, u.target, u.id), u.child, t)

    case r: RemoveArc =>
      this.removeArc(new Arc(r.source, r.target, r.id), t)
  }

  // This is the parent-level reset used if the whole graph is itself nested in
  // another CRDT.
  def reset(t: VersionVector, withConcurrent: Boolean) = {
    val newArcContent =
      this.arcContent.map((arc: Arc[V, E], child: ArcLog) =>
        this.arcReset(child, t, withConcurrent)
      )

    val newVertexContent =
      this.vertexContent.map((v: V, child: VertexLog) =>
        this.vertexReset(child, t, withConcurrent)
      )

    this.copy(newArcContent, newVertexContent)
  }

  // Check if an operation is enabled.
  def isEnabled(op: UWGraphOp[V, E, VertexOp, ArcOp]) = op match {
    case u: UpdateVertex =>
      true 

    case r: RemoveVertex =>
      this.vertexContent.contains(r.id) && !this.vertexIsDefault(this.vertexContent.get(r.id))

    case u: UpdateArc =>
      this.vertexContent.contains(u.source) && !this.vertexIsDefault(this.vertexContent.get(u.source)) &&
      this.vertexContent.contains(u.target) && !this.vertexIsDefault(this.vertexContent.get(u.target))

    case r: RemoveArc =>
      val arc = new Arc(r.source, r.target, r.id)
      this.arcContent.contains(arc) && !this.arcIsDefault(this.arcContent.get(arc))
  }

  //* Helper predicates for the proofs.

  // The effect of two child vertex operations should commute.
  def vertexEffectsCommute(vertex: VertexLog, op1: VertexOp, t1: VersionVector, op2: VertexOp, t2: VersionVector) =
    this.vertexEffect(this.vertexEffect(vertex, op1, t1), op2, t2) ==
    this.vertexEffect(this.vertexEffect(vertex, op2, t2), op1, t1)

  // The effect of a child vertex operation should commute with the reset of that child vertex log.
  def vertexEffectResetCommutes(vertex: VertexLog, op: VertexOp, effectTime: VersionVector, resetTime: VersionVector) =
    this.vertexReset(this.vertexEffect(vertex, op, effectTime), resetTime, true) ==
    this.vertexEffect(this.vertexReset(vertex, resetTime, true), op, effectTime)

  // Resets of the same vertex should commute.
  def vertexResetsCommute(vertex: VertexLog, t1: VersionVector, t2: VersionVector) =
    this.vertexReset(this.vertexReset(vertex, t1, true), t2, true) ==
    this.vertexReset(this.vertexReset(vertex, t2, true), t1, true)

  // Resetting an empty vertex is idempotent
  def emptyVertexResetStable(t: VersionVector) =
    this.vertexReset(this.emptyVertex, t, true) == this.emptyVertex

  // The effect of two child arc operations should commute.
  def arcEffectsCommute(arc: ArcLog, op1: ArcOp, t1: VersionVector, op2: ArcOp, t2: VersionVector) =
    this.arcEffect(this.arcEffect(arc, op1, t1), op2, t2) ==
    this.arcEffect(this.arcEffect(arc, op2, t2), op1, t1)

  // The effect of an arc operation should commute with the reset of that arc by a concurrent remove vertex operation.
  def arcEffectResetCommutes(arc: ArcLog, op: ArcOp, effectTime: VersionVector, resetTime: VersionVector) =
    this.arcReset(this.arcEffect(arc, op, effectTime), resetTime, true) ==
    this.arcEffect(this.arcReset(arc, resetTime, true), op, effectTime)

  // Resets of the same arc should commute.
  def arcResetsCommute(arc: ArcLog, t1: VersionVector, t2: VersionVector) =
    this.arcReset(this.arcReset(arc, t1, true), t2, true) ==
    this.arcReset(this.arcReset(arc, t2, true), t1, true)

  // Resetting an empty arc is idempotent
  def emptyArcResetStable(t: VersionVector) =
    this.arcReset(this.emptyArc, t, true) == this.emptyArc
}

/*
 * Convergence proofs.
 *
 * The 4 operations give 10 pairwise commutation cases. Each proof keeps
 * the assumptions it needs about the nested resettable children.
 */

object UWMultidigraph {
  proof UWMultidigraph_update_update_vertex[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      v1: V,
      v2: V,
      op1: VertexOp,
      op2: VertexOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.vertexEffectsCommute(g.vertexContent.getOrElse(v1, g.emptyVertex), op1, t1, op2, t2) &&
        g.vertexEffectsCommute(g.vertexContent.getOrElse(v2, g.emptyVertex), op2, t2, op1, t1) &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](v1, op1)) &&
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](v2, op2))
      ) =>: {
        g.updateVertex(v1, op1, t1).updateVertex(v2, op2, t2) ==
        g.updateVertex(v2, op2, t2).updateVertex(v1, op1, t1)
      }
    }
  }

  proof UWMultidigraph_update_remove_vertex[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      updatedVertex: V,
      removedVertex: V,
      op: VertexOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.vertexEffectResetCommutes(g.vertexContent.getOrElse(updatedVertex, g.emptyVertex), op, t1, t2) &&
        g.emptyVertexResetStable(t2) &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](updatedVertex, op)) &&
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](removedVertex))
      ) =>: {
        g.updateVertex(updatedVertex, op, t1).removeVertex(removedVertex, t2) ==
        g.removeVertex(removedVertex, t2).updateVertex(updatedVertex, op, t1)
      }
    }
  }

  proof UWMultidigraph_update_vertex_update_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      vertex: V,
      arc: Arc[V, E],
      vertexOp: VertexOp,
      arcOp: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](vertex, vertexOp)) &&
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc.source, arc.target, arc.id, arcOp))
      ) =>: {
        g.updateVertex(vertex, vertexOp, t1).updateArc(arc, arcOp, t2) ==
        g.updateArc(arc, arcOp, t2).updateVertex(vertex, vertexOp, t1)
      }
    }
  }

  proof UWMultidigraph_update_vertex_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      vertex: V,
      arc: Arc[V, E],
      vertexOp: VertexOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](vertex, vertexOp)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc.source, arc.target, arc.id))
      ) =>: {
        g.updateVertex(vertex, vertexOp, t1).removeArc(arc, t2) ==
        g.removeArc(arc, t2).updateVertex(vertex, vertexOp, t1)
      }
    }
  }

  proof UWMultidigraph_remove_vertex_remove_vertex[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      v1: V,
      v2: V,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.vertexResetsCommute(g.vertexContent.getOrElse(v1, g.emptyVertex), t1, t2) &&
        g.vertexResetsCommute(g.vertexContent.getOrElse(v2, g.emptyVertex), t1, t2) &&
        g.arcContent.forall((arc: Arc[V, E], child: ArcLog) => g.arcResetsCommute(child, t1, t2)) &&
        // Operations are enabled
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](v1)) &&
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](v2))
      ) =>: {
        g.removeVertex(v1, t1).removeVertex(v2, t2) ==
        g.removeVertex(v2, t2).removeVertex(v1, t1)
      }
    }
  }

  proof UWMultidigraph_remove_vertex_update_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      vertex: V,
      arc: Arc[V, E],
      op: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcEffectResetCommutes(g.arcContent.getOrElse(arc, g.emptyArc), op, t2, t1) &&
        g.emptyArcResetStable(t1) &&
        // Operations are enabled
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](vertex)) &&
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc.source, arc.target, arc.id, op))
      ) =>: {
        g.removeVertex(vertex, t1).updateArc(arc, op, t2) ==
        g.updateArc(arc, op, t2).removeVertex(vertex, t1)
      }
    }
  }

  proof UWMultidigraph_remove_vertex_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      vertex: V,
      arc: Arc[V, E],
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcResetsCommute(g.arcContent.getOrElse(arc, g.emptyArc), t1, t2) &&
        // Operations are enabled
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](vertex)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc.source, arc.target, arc.id))
      ) =>: {
        g.removeVertex(vertex, t1).removeArc(arc, t2) ==
        g.removeArc(arc, t2).removeVertex(vertex, t1)
      }
    }
  }

  proof UWMultidigraph_update_arc_update_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      arc1: Arc[V, E],
      arc2: Arc[V, E],
      op1: ArcOp,
      op2: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcEffectsCommute(g.arcContent.getOrElse(arc1, g.emptyArc), op1, t1, op2, t2) &&
        g.arcEffectsCommute(g.arcContent.getOrElse(arc2, g.emptyArc), op2, t2, op1, t1) &&
        // Operations are enabled
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc1.source, arc1.target, arc1.id, op1)) &&
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc2.source, arc2.target, arc2.id, op2))
      ) =>: {
        g.updateArc(arc1, op1, t1).updateArc(arc2, op2, t2) ==
        g.updateArc(arc2, op2, t2).updateArc(arc1, op1, t1)
      }
    }
  }

  proof UWMultidigraph_update_arc_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      updatedArc: Arc[V, E],
      removedArc: Arc[V, E],
      op: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcEffectResetCommutes(g.arcContent.getOrElse(updatedArc, g.emptyArc), op, t1, t2) &&
        g.emptyArcResetStable(t2) && 
        // Operations are enabled
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](updatedArc.source, updatedArc.target, updatedArc.id, op)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](removedArc.source, removedArc.target, removedArc.id))
      ) =>: {
        g.updateArc(updatedArc, op, t1).removeArc(removedArc, t2) ==
        g.removeArc(removedArc, t2).updateArc(updatedArc, op, t1)
      }
    }
  }

  proof UWMultidigraph_remove_arc_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog],
      arc1: Arc[V, E],
      arc2: Arc[V, E],
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcResetsCommute(g.arcContent.getOrElse(arc1, g.emptyArc), t1, t2) &&
        g.arcResetsCommute(g.arcContent.getOrElse(arc2, g.emptyArc), t1, t2) &&
        // Operations are enabled
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc1.source, arc1.target, arc1.id)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc2.source, arc2.target, arc2.id))
      ) =>: {
        g.removeArc(arc1, t1).removeArc(arc2, t2) ==
        g.removeArc(arc2, t2).removeArc(arc1, t1)
      }
    }
  }
}
