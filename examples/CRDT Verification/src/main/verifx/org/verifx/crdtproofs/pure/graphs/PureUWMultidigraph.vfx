import org.verifx.crdtproofs.VersionVector
import org.verifx.crdtproofs.pure.ResettableCRDT

/*
 * Implementation of a pure op-based Update-Wins multidigraph nested CRDT,
 * following the specification from:
 *   Olivier, Morcos, Didonet Del Fabro, Gerard.
 *   "A Local-First Collaborative Modeling Approach with Replicated Data Types"
 *   HAL https://cea.hal.science/cea-05322894v1 (2025).
 *
 * Supports nested CRDTs as child elements for vertices and arcs, i.e., each vertex and arc
 * can itself be a CRDT (as long as it is resettable).
 */

// Arc identity
class Arc[V, E](src: V, dst: V, id: E)

// CRDT update operations.
object UWGraphOps {
  enum UWGraphOp[V, E, VertexOp, ArcOp] {
    UpdateVertex(id: V, child: VertexOp) |
    RemoveVertex(id: V) |
    UpdateArc(src: V, dst: V, id: E, child: ArcOp) |
    RemoveArc(src: V, dst: V, id: E)
  }
}

/*
 * Observable value of a UW multidigraph.
 * Vertices and arcs are maps so every visible element keeps the label returned
 * by its nested child read function.
 */
class LabeledMultidigraph[V, Vl, E, Al](vertices: Map[V, Vl], arcs: Map[Arc[V, E], Al]) {
  def addVertex(v: V, label: Vl) = new LabeledMultidigraph(this.vertices.add(v, label), this.arcs)

  def addArc(from: V, to: V, e: E, label: Al) = new LabeledMultidigraph(this.vertices, this.arcs.add(new Arc(from, to, e), label))

  def removeVertex(v: V) = new LabeledMultidigraph(this.vertices.remove(v), this.arcs.filter((arc: Arc[V, E], label: Al) => arc.src != v && arc.dst != v))

  def removeArc(from: V, to: V, e: E) = new LabeledMultidigraph(this.vertices, this.arcs.remove(new Arc(from, to, e)))

  def containsVertex(v: V) = this.vertices.contains(v)

  def containsArc(from: V, to: V, e: E) = this.arcs.contains(new Arc(from, to, e))

  def isValid() =
    this.arcs.forall((arc: Arc[V, E], label: Al) => this.containsVertex(arc.src) && this.containsVertex(arc.dst))
}

class UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel](
  vertexChild: ResettableChild[VertexLog, VertexOp, VertexLabel],
  arcChild: ResettableChild[ArcLog, ArcOp, ArcLabel],
  // The graph content is stored in two maps: one for vertices and one for arcs.
  arcContent: Map[Arc[V, E], ArcLog] = new Map[Arc[V, E], ArcLog](),
  vertexContent: Map[V, VertexLog] = new Map[V, VertexLog]()
) {
  def copy(
    newArcContent: Map[Arc[V, E], ArcLog],
    newVertexContent: Map[V, VertexLog]
  ) =
    // Preserve the child interface while replacing the graph contents.
    new UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel](
      this.vertexChild,
      this.arcChild,
      newArcContent,
      newVertexContent
    )

  // Update-wins creation/update of a vertex: create the child from empty if
  // absent, then delegate the nested operation to that child.
  def updateVertex(v: V, op: VertexOp, t: VersionVector) = {
    val child = this.vertexContent.getOrElse(v, this.vertexChild.empty)
    val newChild = this.vertexChild.effect(child, op, t)
    this.copy(this.arcContent, this.vertexContent.add(v, newChild))
  }

  // Removing a vertex resets its child and every incident arc child. The
  // conservative reset keeps operations concurrent with this remove.
  def removeVertex(v: V, t: VersionVector) = {
    val newVertexContent =
      if (this.vertexContent.contains(v))
        this.vertexContent.add(v, this.vertexChild.reset(this.vertexContent.get(v), t, true))
      else
        this.vertexContent

    val newArcContent =
      this.arcContent.map((arc: Arc[V, E], child: ArcLog) =>
        if (arc.src == v || arc.dst == v)
          this.arcChild.reset(child, t, true)
        else
          child
      )

    this.copy(newArcContent, newVertexContent)
  }

  // Update-wins creation/update of an arc child.
  def updateArc(arc: Arc[V, E], op: ArcOp, t: VersionVector) = {
    val child = this.arcContent.getOrElse(arc, this.arcChild.empty)
    val newChild = this.arcChild.effect(child, op, t)
    this.copy(this.arcContent.add(arc, newChild), this.vertexContent)
  }

  // Removing an arc does not affect concurrent updates to that arc
  def removeArc(arc: Arc[V, E], t: VersionVector) = {
    val newArcContent =
      if (this.arcContent.contains(arc))
        this.arcContent.add(arc, this.arcChild.reset(this.arcContent.get(arc), t, true))
      else
        this.arcContent

    this.copy(newArcContent, this.vertexContent)
  }

  // Dispatcher matching the operation enum.
  def effect(op: UWGraphOp[V, E, VertexOp, ArcOp], t: VersionVector) = op match {
    case u: UpdateVertex =>
      this.updateVertex(u.id, u.child, t)

    case r: RemoveVertex =>
      this.removeVertex(r.id, t)

    case u: UpdateArc =>
      this.updateArc(new Arc(u.src, u.dst, u.id), u.child, t)

    case r: RemoveArc =>
      this.removeArc(new Arc(r.src, r.dst, r.id), t)
  }

  // Check if an operation is enabled.
  def isEnabled(op: UWGraphOp[V, E, VertexOp, ArcOp]) = op match {
    case u: UpdateVertex =>
      true 

    case r: RemoveVertex =>
      this.vertexContent.contains(r.id) && !this.vertexChild.isDefaultLog(this.vertexContent.get(r.id))

    case u: UpdateArc =>
      this.vertexContent.contains(u.src) && !this.vertexChild.isDefaultLog(this.vertexContent.get(u.src)) &&
      this.vertexContent.contains(u.dst) && !this.vertexChild.isDefaultLog(this.vertexContent.get(u.dst))

    case r: RemoveArc =>
      val arc = new Arc(r.src, r.dst, r.id)
      this.arcContent.contains(arc) && !this.arcChild.isDefaultLog(this.arcContent.get(arc))
  }

  def readVertex(v: V): VertexLabel =
    this.vertexChild.applyRead(this.vertexContent.getOrElse(v, this.vertexChild.empty))

  def readArc(arc: Arc[V, E]): ArcLabel =
    this.arcChild.applyRead(this.arcContent.getOrElse(arc, this.arcChild.empty))

  def read(): LabeledMultidigraph[V, VertexLabel, E, ArcLabel] = {
    val visibleVertices: Map[V, VertexLabel] =
      this.vertexContent
        .filter((v: V, log: VertexLog) => !this.vertexChild.isDefaultLog(log))
        .mapValues((log: VertexLog) => this.vertexChild.applyRead(log))

    val visibleArcs: Map[Arc[V, E], ArcLabel] =
      this.arcContent
        .filter((arc: Arc[V, E], log: ArcLog) =>
          !this.arcChild.isDefaultLog(log) &&
          visibleVertices.contains(arc.src) &&
          visibleVertices.contains(arc.dst)
        )
        .mapValues((log: ArcLog) => this.arcChild.applyRead(log))

    new LabeledMultidigraph[V, VertexLabel, E, ArcLabel](visibleVertices, visibleArcs)
  }
}

object UWMultidigraph {
  /* Validity:
   * An arc can only be visible in the evaluated graph when both of its endpoints are visible as vertices.
   * I.e., dangling arcs are hidden, and the invariant A ⊆ V × V × E holds in the evaluated graph.
   */
  proof UWMultidigraph_validity[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      src: V,
      dst: V,
      edge: E
    ) {
      g.read().containsArc(src, dst, edge) =>: (
        g.read().containsVertex(src) &&
        g.read().containsVertex(dst)
      )
    }
  }

  /* Deterministic read: the same graph state always evaluates to the same observable graph. */
  proof UWMultidigraph_deterministic_read[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g1: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      g2: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel]
    ) {
      (
        g1.vertexChild == g2.vertexChild &&
        g1.arcChild == g2.arcChild &&
        g1.arcContent == g2.arcContent &&
        g1.vertexContent == g2.vertexContent
      ) =>: {
        g1.read() == g2.read()
      }
    }
  }

  /*
  * Convergence proofs.
  *
  * The 4 operations give 10 pairwise commutation cases. Each proof keeps
  * the assumptions it needs about the nested resettable children.
  */

  proof UWMultidigraph_update_update_vertex[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      v1: V,
      v2: V,
      op1: VertexOp,
      op2: VertexOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.vertexChild.effectsCommute(g.vertexContent.getOrElse(v1, g.vertexChild.empty), op1, t1, op2, t2) &&
        g.vertexChild.effectsCommute(g.vertexContent.getOrElse(v2, g.vertexChild.empty), op2, t2, op1, t1) &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](v1, op1)) &&
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](v2, op2))
      ) =>: {
        g.updateVertex(v1, op1, t1).updateVertex(v2, op2, t2) ==
        g.updateVertex(v2, op2, t2).updateVertex(v1, op1, t1)
      }
    }
  }

  proof UWMultidigraph_update_remove_vertex[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      updatedVertex: V,
      removedVertex: V,
      op: VertexOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.vertexChild.effectResetCommutes(g.vertexContent.getOrElse(updatedVertex, g.vertexChild.empty), op, t1, t2, true) &&
        g.vertexChild.emptyResetStable(t2) &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](updatedVertex, op)) &&
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](removedVertex))
      ) =>: {
        g.updateVertex(updatedVertex, op, t1).removeVertex(removedVertex, t2) ==
        g.removeVertex(removedVertex, t2).updateVertex(updatedVertex, op, t1)
      }
    }
  }

  proof UWMultidigraph_update_vertex_update_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      vertex: V,
      arc: Arc[V, E],
      vertexOp: VertexOp,
      arcOp: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](vertex, vertexOp)) &&
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc.src, arc.dst, arc.id, arcOp))
      ) =>: {
        g.updateVertex(vertex, vertexOp, t1).updateArc(arc, arcOp, t2) ==
        g.updateArc(arc, arcOp, t2).updateVertex(vertex, vertexOp, t1)
      }
    }
  }

  proof UWMultidigraph_update_vertex_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      vertex: V,
      arc: Arc[V, E],
      vertexOp: VertexOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        // Operations are enabled
        g.isEnabled(new UpdateVertex[V, E, VertexOp, ArcOp](vertex, vertexOp)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc.src, arc.dst, arc.id))
      ) =>: {
        g.updateVertex(vertex, vertexOp, t1).removeArc(arc, t2) ==
        g.removeArc(arc, t2).updateVertex(vertex, vertexOp, t1)
      }
    }
  }

  proof UWMultidigraph_remove_vertex_remove_vertex[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      v1: V,
      v2: V,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.vertexChild.resetsCommute(g.vertexContent.getOrElse(v1, g.vertexChild.empty), t1, t2, true) &&
        g.vertexChild.resetsCommute(g.vertexContent.getOrElse(v2, g.vertexChild.empty), t1, t2, true) &&
        g.arcContent.forall((arc: Arc[V, E], child: ArcLog) => g.arcChild.resetsCommute(child, t1, t2, true)) &&
        // Operations are enabled
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](v1)) &&
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](v2))
      ) =>: {
        g.removeVertex(v1, t1).removeVertex(v2, t2) ==
        g.removeVertex(v2, t2).removeVertex(v1, t1)
      }
    }
  }

  proof UWMultidigraph_remove_vertex_update_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      vertex: V,
      arc: Arc[V, E],
      op: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcChild.effectResetCommutes(g.arcContent.getOrElse(arc, g.arcChild.empty), op, t2, t1, true) &&
        g.arcChild.emptyResetStable(t1) &&
        // Operations are enabled
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](vertex)) &&
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc.src, arc.dst, arc.id, op))
      ) =>: {
        g.removeVertex(vertex, t1).updateArc(arc, op, t2) ==
        g.updateArc(arc, op, t2).removeVertex(vertex, t1)
      }
    }
  }

  proof UWMultidigraph_remove_vertex_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      vertex: V,
      arc: Arc[V, E],
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcChild.resetsCommute(g.arcContent.getOrElse(arc, g.arcChild.empty), t1, t2, true) &&
        // Operations are enabled
        g.isEnabled(new RemoveVertex[V, E, VertexOp, ArcOp](vertex)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc.src, arc.dst, arc.id))
      ) =>: {
        g.removeVertex(vertex, t1).removeArc(arc, t2) ==
        g.removeArc(arc, t2).removeVertex(vertex, t1)
      }
    }
  }

  proof UWMultidigraph_update_arc_update_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      arc1: Arc[V, E],
      arc2: Arc[V, E],
      op1: ArcOp,
      op2: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcChild.effectsCommute(g.arcContent.getOrElse(arc1, g.arcChild.empty), op1, t1, op2, t2) &&
        g.arcChild.effectsCommute(g.arcContent.getOrElse(arc2, g.arcChild.empty), op2, t2, op1, t1) &&
        // Operations are enabled
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc1.src, arc1.dst, arc1.id, op1)) &&
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](arc2.src, arc2.dst, arc2.id, op2))
      ) =>: {
        g.updateArc(arc1, op1, t1).updateArc(arc2, op2, t2) ==
        g.updateArc(arc2, op2, t2).updateArc(arc1, op1, t1)
      }
    }
  }

  proof UWMultidigraph_update_arc_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      updatedArc: Arc[V, E],
      removedArc: Arc[V, E],
      op: ArcOp,
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcChild.effectResetCommutes(g.arcContent.getOrElse(updatedArc, g.arcChild.empty), op, t1, t2, true) &&
        g.arcChild.emptyResetStable(t2) && 
        // Operations are enabled
        g.isEnabled(new UpdateArc[V, E, VertexOp, ArcOp](updatedArc.src, updatedArc.dst, updatedArc.id, op)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](removedArc.src, removedArc.dst, removedArc.id))
      ) =>: {
        g.updateArc(updatedArc, op, t1).removeArc(removedArc, t2) ==
        g.removeArc(removedArc, t2).updateArc(updatedArc, op, t1)
      }
    }
  }

  proof UWMultidigraph_remove_arc_remove_arc[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel] {
    forall(
      g: UWMultidigraphLog[V, E, VertexOp, ArcOp, VertexLog, ArcLog, VertexLabel, ArcLabel],
      arc1: Arc[V, E],
      arc2: Arc[V, E],
      t1: VersionVector,
      t2: VersionVector
    ) {
      (
        t1.concurrent(t2) &&
        // Version vectors are well-formed
        t1.vector.forall((n: Int) => n >= 0) &&
        t2.vector.forall((n: Int) => n >= 0) &&
        t1.vector.size == t2.vector.size &&
        g.arcChild.resetsCommute(g.arcContent.getOrElse(arc1, g.arcChild.empty), t1, t2, true) &&
        g.arcChild.resetsCommute(g.arcContent.getOrElse(arc2, g.arcChild.empty), t1, t2, true) &&
        // Operations are enabled
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc1.src, arc1.dst, arc1.id)) &&
        g.isEnabled(new RemoveArc[V, E, VertexOp, ArcOp](arc2.src, arc2.dst, arc2.id))
      ) =>: {
        g.removeArc(arc1, t1).removeArc(arc2, t2) ==
        g.removeArc(arc2, t2).removeArc(arc1, t1)
      }
    }
  }
}
