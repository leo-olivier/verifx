import org.verifx.crdtproofs.VersionVector
import org.verifx.crdtproofs.pure.ResettableCRDT

trait ResettableCRDTProof3[Op[A, B, C], T[A, B, C] <: ResettableCRDT[Op[A, B, C], C, T[A, B, C]]] {
  proof is_a_ResettableCRDT[A, B, C] {
    forall(
      s: T[A, B, C],
      op1: Op[A, B, C],
      op2: Op[A, B, C],
      effectTime1: VersionVector,
      effectTime2: VersionVector,
      resetTime: VersionVector,
      conservative: Boolean
    ) {
      (
        effectTime1.concurrent(effectTime2) &&
        effectTime1.concurrent(resetTime) &&
        effectTime2.concurrent(resetTime) &&
        // Version vectors are well-formed
        effectTime1.vector.forall((n: Int) => n >= 0) &&
        effectTime2.vector.forall((n: Int) => n >= 0) &&
        resetTime.vector.forall((n: Int) => n >= 0) &&
        effectTime1.vector.size == effectTime2.vector.size &&
        effectTime1.vector.size == resetTime.vector.size &&
        s.effectsCommute(op1, effectTime1, op2, effectTime2) &&
        s.effectResetCommutes(op1, effectTime1, resetTime, conservative) &&
        s.resetsCommute(effectTime1, conservative, effectTime2, conservative)
      ) =>: {
        val effects = s.effect(op1, effectTime1).effect(op2, effectTime2).equals(s.effect(op2, effectTime2).effect(op1, effectTime1))
        val effectReset = s.effect(op1, effectTime1).reset(resetTime, conservative).equals(s.reset(resetTime, conservative).effect(op1, effectTime1))
        val resets = s.reset(effectTime1, conservative).reset(effectTime2, conservative).equals(s.reset(effectTime2, conservative).reset(effectTime1, conservative))

        effects && effectReset && resets
      }
    }
  }
}
